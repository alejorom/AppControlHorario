@page "/Account/Register"
@using GHL.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Web
@using GHL.BlazorApp.Components.Layout
@using System.ComponentModel.DataAnnotations
@layout AuthLayout
@rendermode RenderMode.InteractiveServer
@attribute [AllowAnonymous]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

<!-- Title -->
<PageTitle>Registro - GHL</PageTitle>

<!-- Main Container -->
<MudPaper Elevation="0" Class="register-card">
    
    <!-- Visual Header -->
    <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mb-8">
        <div class="lime-icon-box">
            <MudIcon Icon="@Icons.Material.Outlined.PersonAdd" Class="header-icon" />
        </div>
        <MudText Typo="Typo.h5" Class="header-title">Crear Cuenta</MudText>
        <MudText Typo="Typo.body2" Class="header-subtitle">Empieza a gestionar tu tiempo hoy</MudText>
    </MudStack>
    
    <!-- Success/Error Feedback -->
    @if (_errors.Any())
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4 rounded-alert">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </MudAlert>
    }
    
    <!-- Registration Form -->
    <EditForm Model="@Input" OnValidSubmit="RegisterUser" OnInvalidSubmit="HandleInvalidSubmit" Context="editContext" FormName="RegisterForm">
        <DataAnnotationsValidator />
        
        <MudStack Spacing="3">
            
            <!-- Full Name -->
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #374151; margin-bottom: 4px; margin-left: 2px;">
                    Nombre Completo <span style="color: #DC2626;">*</span>
                </MudText>
                <MudTextField @bind-Value="Input.FullName" 
                              For="@(() => Input.FullName)"
                              Placeholder="Ej. Juan Pérez"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Person"
                              AdornmentColor="Color.Default"
                              Class="modern-input"
                              Immediate="true" />
            </div>

            <!-- Email -->
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #374151; margin-bottom: 4px; margin-left: 2px;">
                    Email <span style="color: #DC2626;">*</span>
                </MudText>
                <MudTextField @bind-Value="Input.Email" 
                              For="@(() => Input.Email)"
                              Placeholder="nombre@ejemplo.com"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Email"
                              AdornmentColor="Color.Default"
                              Class="modern-input"
                              Immediate="true" />
            </div>
            
            <!-- Password -->
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #374151; margin-bottom: 4px; margin-left: 2px;">
                    Contraseña <span style="color: #DC2626;">*</span>
                </MudText>
                <MudTextField @bind-Value="Input.Password" 
                              For="@(() => Input.Password)"
                              Placeholder="••••••••"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentColor="Color.Default"
                              Class="modern-input"
                              Immediate="true" />
                
                <!-- Password Requirements Checkmarks -->
                <MudStack Spacing="0" Class="mt-2 ml-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(Input.Password?.Length >= 8 ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" 
                                 Size="Size.Small" 
                                 Style="@(Input.Password?.Length >= 8 ? "color:#C6FF00" : "color:#D1D5DB")" />
                        <MudText Typo="Typo.caption" Style="@(Input.Password?.Length >= 8 ? "color:#374151" : "color:#9CA3AF")">Mínimo 8 caracteres</MudText>
                    </MudStack>
                    
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(HasUpper(Input.Password) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" 
                                 Size="Size.Small" 
                                 Style="@(HasUpper(Input.Password) ? "color:#C6FF00" : "color:#D1D5DB")" />
                        <MudText Typo="Typo.caption" Style="@(HasUpper(Input.Password) ? "color:#374151" : "color:#9CA3AF")">Una mayúscula</MudText>
                    </MudStack>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(HasLower(Input.Password) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" 
                                 Size="Size.Small" 
                                 Style="@(HasLower(Input.Password) ? "color:#C6FF00" : "color:#D1D5DB")" />
                        <MudText Typo="Typo.caption" Style="@(HasLower(Input.Password) ? "color:#374151" : "color:#9CA3AF")">Una minúscula</MudText>
                    </MudStack>
                    
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(HasDigit(Input.Password) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" 
                                 Size="Size.Small" 
                                 Style="@(HasDigit(Input.Password) ? "color:#C6FF00" : "color:#D1D5DB")" />
                        <MudText Typo="Typo.caption" Style="@(HasDigit(Input.Password) ? "color:#374151" : "color:#9CA3AF")">Un número</MudText>
                    </MudStack>
                    
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(HasSpecial(Input.Password) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" 
                                 Size="Size.Small" 
                                 Style="@(HasSpecial(Input.Password) ? "color:#C6FF00" : "color:#D1D5DB")" />
                        <MudText Typo="Typo.caption" Style="@(HasSpecial(Input.Password) ? "color:#374151" : "color:#9CA3AF")">Un caracter especial</MudText>
                    </MudStack>
                </MudStack>
            </div>
            
            <!-- Confirm Password -->
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #374151; margin-bottom: 4px; margin-left: 2px;">
                    Confirmar contraseña <span style="color: #DC2626;">*</span>
                </MudText>
                <MudTextField @bind-Value="Input.ConfirmPassword" 
                              For="@(() => Input.ConfirmPassword)"
                              Placeholder="••••••••"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Lock"
                              AdornmentColor="Color.Default"
                              Class="modern-input"
                              Immediate="true" />
            </div>
            
            <!-- Submit Button -->
            <MudButton ButtonType="ButtonType.Submit" 
                       Variant="Variant.Filled" 
                       Class="submit-btn mt-2"
                       FullWidth="true"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2 text-dark" />
                }
                Crear Cuenta
            </MudButton>
            
        </MudStack>
    </EditForm>
    
    <!-- Login Link -->
    <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="mt-8">
        <MudText Typo="Typo.body2" Class="text-gray">¿Ya tienes cuenta?</MudText>
        <MudLink Href="/Account/Login" Class="link-lime">Iniciar Sesión</MudLink>
    </MudStack>
    
</MudPaper>

<!-- Embedded Styles for "Modern Lime" Vibe -->
