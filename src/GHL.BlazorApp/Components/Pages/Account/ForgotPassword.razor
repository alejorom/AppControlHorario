@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@using GHL.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using GHL.BlazorApp.Components.Layout
@using GHL.BlazorApp.Services.Identity
@layout AuthLayout
@attribute [AllowAnonymous]
@inject UserManager<ApplicationUser> UserManager
@inject AccountEmailSender AccountEmailSender
@inject ILogger<ForgotPassword> Logger

<PageTitle>Recuperar contraseña - GHL</PageTitle>

<MudPaper Elevation="0" Class="pa-8" Style="width: 100%; max-width: 420px; border-radius: 32px;">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5" Style="font-weight: 800;">Recuperar contraseña</MudText>

        @if (_sent)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                Si el correo está registrado, recibirás un enlace para restablecer tu contraseña. El enlace es válido por 24 horas.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2">Ingresa tu correo y te enviaremos un enlace para restablecer tu contraseña.</MudText>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_error</MudAlert>
            }

            <EditForm Model="Input" OnValidSubmit="SendAsync" FormName="ForgotPasswordForm">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="Input.Email"
                                  For="@(() => Input.Email)"
                                  Label="Email"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Enviar enlace
                    </MudButton>
                </MudStack>
            </EditForm>
        }

        <MudLink Href="/Account/Login">Volver a iniciar sesión</MudLink>
    </MudStack>
</MudPaper>

@code {
    private bool _isLoading;
    private bool _sent;
    private string? _error;

    private ForgotPasswordModel Input { get; set; } = new();

    private async Task SendAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var user = await UserManager.FindByEmailAsync(Input.Email);
            if (user is not null && await UserManager.IsEmailConfirmedAsync(user))
            {
                await AccountEmailSender.SendPasswordResetAsync(user);
            }

            // Same answer whether or not the account exists
            _sent = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset request failed");
            _error = "No pudimos procesar la solicitud. Inténtalo de nuevo más tarde.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class ForgotPasswordModel
    {
        [Required(ErrorMessage = "El email es obligatorio")]
        [EmailAddress(ErrorMessage = "Formato de email inválido")]
        public string Email { get; set; } = string.Empty;
    }
}
