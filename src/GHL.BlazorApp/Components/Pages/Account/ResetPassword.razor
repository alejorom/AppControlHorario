@page "/Account/ResetPassword"
@using System.ComponentModel.DataAnnotations
@using GHL.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using GHL.BlazorApp.Components.Layout
@using GHL.BlazorApp.Services.Identity
@layout AuthLayout
@attribute [AllowAnonymous]
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<ResetPassword> Logger

<PageTitle>Restablecer contraseña - GHL</PageTitle>

<MudPaper Elevation="0" Class="pa-8" Style="width: 100%; max-width: 420px; border-radius: 32px;">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5" Style="font-weight: 800;">Restablecer contraseña</MudText>

        @if (_linkExpired)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">El enlace no es válido o ha expirado.</MudAlert>
            <MudLink Href="/Account/ForgotPassword">Generar un nuevo enlace</MudLink>
        }
        else
        {
            @if (_errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                    @foreach (var error in _errors)
                    {
                        <div>@error</div>
                    }
                </MudAlert>
            }

            <EditForm Model="Input" OnValidSubmit="ResetAsync" FormName="ResetPasswordForm">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="Input.Password"
                                  For="@(() => Input.Password)"
                                  Label="Nueva contraseña"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  HelperText="Mínimo 8 caracteres, con mayúscula, minúscula, número y caracter especial."
                                  Immediate="true" />
                    <MudTextField @bind-Value="Input.ConfirmPassword"
                                  For="@(() => Input.ConfirmPassword)"
                                  Label="Confirmar contraseña"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Restablecer contraseña
                    </MudButton>
                </MudStack>
            </EditForm>
        }
    </MudStack>
</MudPaper>

@code {
    private bool _isLoading;
    private bool _linkExpired;
    private readonly List<string> _errors = new();

    private ResetPasswordModel Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    protected override void OnInitialized()
    {
        _linkExpired = string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code);
    }

    private async Task ResetAsync()
    {
        _isLoading = true;
        _errors.Clear();

        try
        {
            var user = await UserManager.FindByIdAsync(UserId!);
            if (user is null)
            {
                _linkExpired = true;
                return;
            }

            string token;
            try
            {
                token = AccountEmailSender.Decode(Code!);
            }
            catch (FormatException)
            {
                _linkExpired = true;
                return;
            }

            var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/Account/Login?reset=true", forceLoad: true);
                return;
            }

            if (result.Errors.Any(e => e.Code == nameof(IdentityErrorDescriber.InvalidToken)))
            {
                _linkExpired = true;
                return;
            }

            foreach (var error in result.Errors.Select(IdentityErrorTranslator.Translate).Distinct())
            {
                _errors.Add(error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset failed");
            _errors.Add("No pudimos restablecer la contraseña. Inténtalo de nuevo más tarde.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "La contraseña es obligatoria")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
