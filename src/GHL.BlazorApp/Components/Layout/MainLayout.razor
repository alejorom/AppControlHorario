@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudSnackbarProvider />
<MudDialogProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="0" Style="background: #ffffff; border-bottom: 1px solid #e0e0e0;">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" Style="color: #1C4532;" />
                <MudSpacer />
                <MudText Typo="Typo.h6" Style="color: #1C4532; font-weight: 600;">@DateTime.Now.ToString("MMMM yyyy")</MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Style="color: #666;" />
                
                <!-- Explicit Logout for visibility -->
                <!-- Logout is a POST with antiforgery token; buttons submit this form via the form attribute -->
                <form id="logout-form" method="post" action="/Account/PerformLogout">
                    <AntiforgeryToken />
                </form>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Error" ButtonType="ButtonType.Submit" form="logout-form" Title="Cerrar Sesión" />

                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="cursor: pointer; margin-left: 8px;">
                             <MudAvatar Color="Color.Primary" Size="Size.Small" Style="background: #1C4532;">
                                @(context.User.FindFirst("FullName")?.Value?.Substring(0, 1).ToUpper() ?? context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Style="color: #1C4532; font-weight: 600;">
                                @(context.User.FindFirst("FullName")?.Value ?? context.User.Identity?.Name)
                            </MudText>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Color="Color.Default" />
                        </MudStack>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Person">Perfil</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="/settings">Configuración</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" Style="color: #DC2626;">
                            <button type="submit" form="logout-form" class="logout-menu-button">Cerrar Sesión</button>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" 
                       Style="background: linear-gradient(180deg, #1C4532 0%, #0D2618 100%);">
                <MudDrawerHeader Style="padding: 24px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Style="color: #4ADE80; font-size: 28px;" />
                        <MudText Typo="Typo.h6" Style="color: white; font-weight: 700;">GHL Control</MudText>
                    </MudStack>
                </MudDrawerHeader>

                <MudNavMenu Style="padding: 0 12px;">
                    <MudText Typo="Typo.overline" Style="color: #9CA3AF; padding: 16px 12px 8px; font-size: 11px;">MENU</MudText>
                    
                    <MudNavLink Href="/" Match="NavLinkMatch.All" 
                                Icon="@Icons.Material.Filled.Dashboard"
                                Style="color: white; margin-bottom: 4px;"
                                ActiveClass="mud-nav-link-active">
                        Dashboard
                    </MudNavLink>
                    
                    <MudNavLink Href="/statistics" 
                                Icon="@Icons.Material.Filled.BarChart"
                                Style="color: #9CA3AF; margin-bottom: 4px;"
                                ActiveClass="mud-nav-link-active">
                        Estadísticas
                    </MudNavLink>
                    
                    <MudNavLink Href="/history" 
                                Icon="@Icons.Material.Filled.History"
                                Style="color: #9CA3AF; margin-bottom: 4px;"
                                ActiveClass="mud-nav-link-active">
                        Historial
                    </MudNavLink>

                    <MudText Typo="Typo.overline" Style="color: #9CA3AF; padding: 24px 12px 8px; font-size: 11px;">GENERAL</MudText>
                    
                    <MudNavLink Href="/settings" 
                                Icon="@Icons.Material.Filled.Settings"
                                Style="color: #9CA3AF; margin-bottom: 4px;"
                                ActiveClass="mud-nav-link-active">
                        Configuración
                    </MudNavLink>
                </MudNavMenu>

                <MudSpacer />

                <div style="padding: 16px; margin: 16px; background: linear-gradient(135deg, #4ADE80 0%, #22C55E 100%); border-radius: 16px;">
                    <MudText Typo="Typo.subtitle1" Style="color: #0D2618; font-weight: 600;">
                        Mejora tu productividad
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #166534; margin-top: 8px;">
                        Registra tus horas de trabajo con precisión.
                    </MudText>
                </div>
            </MudDrawer>

            <MudMainContent Style="background: #F8FAFC; min-height: 100vh; padding: 24px;">
                @Body
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<style>
    .logout-menu-button {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
        font: inherit;
        cursor: pointer;
    }

    .mud-nav-link-active {
        background: transparent !important;
        color: #B7F129 !important; /* Neon Green Siohioma highlight */
        border-left: 4px solid #B7F129 !important;
        padding-left: 12px !important; /* Adjust padding to offset the border visually */
    }
    
    .mud-nav-link-active .mud-nav-link-icon.mud-nav-link-icon-default {
        color: #B7F129 !important;
    }
    
    .mud-nav-link:hover {
        background: rgba(255, 255, 255, 0.05) !important;
    }
</style>

@code {
    private bool _drawerOpen = true;
    
    private MudTheme _theme = new MudTheme
    {
        Palette = new PaletteLight
        {
            Primary = "#1C4532",
            Secondary = "#4ADE80",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1C4532"
        },
        Typography = new Typography
        {
            Default = new Default
            {
                FontFamily = new[] { "Inter", "sans-serif" }
            }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
