@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudSnackbarProvider />
<MudDialogProvider />

<MudLayout>
    <MudMainContent Style="background: #FAFAFA; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _theme = new MudTheme
    {
        Palette = new PaletteLight
        {
            Primary = "#C6FF00", // Lime Green Vibrante
            Secondary = "#000000",
            Background = "#FAFAFA",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#000000",
            TextPrimary = "#1F2937",
            TextSecondary = "#6B7280",
            ActionDefault = "#9CA3AF"
        },
        Typography = new Typography
        {
            Default = new Default
            {
                FontFamily = new[] { "Inter", "sans-serif" }
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        }
    };
}
